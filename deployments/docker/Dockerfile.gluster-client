# Use official GlusterFS Fedora-based image for latest GlusterFS version
# Force AMD64 platform to avoid compatibility issues on ARM64 Macs
FROM --platform=linux/amd64 gluster/gluster-fedora:latest

# Install additional tools for our use case (client functionality already included)
# Skip update for faster builds, just install what we need
RUN dnf install -y \
    curl \
    ca-certificates \
    which \
    procps-ng \
    iputils \
    bash \
    fuse \
    && dnf clean all

# Create mount directories
RUN mkdir -p /mnt/shared \
    && mkdir -p /mnt/glusterfs

# Enable FUSE (may already be configured in official image)
RUN echo 'user_allow_other' >> /etc/fuse.conf || true

# Environment variables
ENV GLUSTER_CLUSTER_NAME="gluster-cluster"
ENV GLUSTER_SERVER=""
ENV GLUSTER_VOLUME="shared"
ENV MOUNT_POINT="/mnt/shared"
ENV RETRY_COUNT="30"
ENV RETRY_DELAY="5"

# Create enhanced mount script for official GlusterFS client image
RUN printf '#!/bin/bash\n\
set -e\n\
\n\
echo "Starting GlusterFS client with official image..."\n\
echo "Cluster: $GLUSTER_CLUSTER_NAME"\n\
echo "Server: $GLUSTER_SERVER"\n\
echo "Volume: $GLUSTER_VOLUME"\n\
echo "Mount Point: $MOUNT_POINT"\n\
\n\
# Wait for GlusterFS server to be ready\n\
echo "Waiting for GlusterFS server to be ready..."\n\
for i in $(seq 1 $RETRY_COUNT); do\n\
    if ping -c 1 $GLUSTER_SERVER > /dev/null 2>&1; then\n\
        echo "Server $GLUSTER_SERVER is reachable"\n\
        # Additional check: test gluster port\n\
        if timeout 5 bash -c "</dev/tcp/$GLUSTER_SERVER/24007" 2>/dev/null; then\n\
            echo "GlusterFS port 24007 is accessible"\n\
            break\n\
        fi\n\
    fi\n\
    echo "Waiting for server... (attempt $i/$RETRY_COUNT)"\n\
    sleep $RETRY_DELAY\n\
done\n\
\n\
# Wait additional time for GlusterFS to be fully ready\n\
sleep 30\n\
\n\
# Create mount point\n\
mkdir -p "$MOUNT_POINT"\n\
\n\
# Mount the volume using the latest GlusterFS client\n\
echo "Mounting GlusterFS volume with official client..."\n\
mount.glusterfs "$GLUSTER_SERVER:/$GLUSTER_VOLUME" "$MOUNT_POINT"\n\
\n\
if mount | grep -q "$GLUSTER_SERVER:/$GLUSTER_VOLUME"; then\n\
    echo "Successfully mounted GlusterFS volume!"\n\
    echo "Mount point: $MOUNT_POINT"\n\
    ls -la "$MOUNT_POINT/"\n\
else\n\
    echo "ERROR: Failed to mount GlusterFS volume"\n\
    exit 1\n\
fi\n\
\n\
# Set permissions\n\
chmod 755 "$MOUNT_POINT"\n\
chown root:root "$MOUNT_POINT"\n\
\n\
echo "GlusterFS client setup completed with official image!"\n\
\n\
# Keep container running\n\
tail -f /dev/null\n\
' > /usr/local/bin/mount-gluster.sh && chmod +x /usr/local/bin/mount-gluster.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD mount | grep glusterfs || exit 1

CMD ["/usr/local/bin/mount-gluster.sh"]