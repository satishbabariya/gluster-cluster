# Use official GlusterFS Fedora-based image for latest GlusterFS version
# Force AMD64 platform to avoid compatibility issues on ARM64 Macs
FROM --platform=linux/amd64 gluster/gluster-fedora:latest

# Install additional tools for our use case (client functionality already included)
# Skip update for faster builds, just install what we need
RUN dnf install -y \
    curl \
    ca-certificates \
    which \
    procps-ng \
    iputils \
    bash \
    fuse \
    && dnf clean all

# Create mount directories
RUN mkdir -p /mnt/shared \
    && mkdir -p /mnt/glusterfs

# Enable FUSE (may already be configured in official image)
RUN echo 'user_allow_other' >> /etc/fuse.conf || true

# Environment variables
ENV GLUSTER_CLUSTER_NAME="gluster-cluster"
ENV GLUSTER_SERVER=""
ENV GLUSTER_VOLUME="shared"
ENV MOUNT_POINT="/mnt/shared"
ENV RETRY_COUNT="30"
ENV RETRY_DELAY="5"

# Copy and setup the mount script
COPY scripts/mount-gluster.sh /usr/local/bin/mount-gluster.sh
RUN chmod +x /usr/local/bin/mount-gluster.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD mount | grep glusterfs || exit 1

CMD ["/usr/local/bin/mount-gluster.sh"]