# Stage 1: Build the Go application
FROM golang:1.21-alpine AS go-builder

# Install git for Go modules that might need it
RUN apk add --no-cache git

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o gluster-manager ./cmd/gluster-manager

# Stage 2: Production image with minimal footprint
FROM alpine:latest

# Install required packages for cluster management
RUN apk --no-cache add \
    ca-certificates \
    docker-cli \
    curl \
    bash \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy the built binary from go-builder stage
COPY --from=go-builder /build/gluster-manager /usr/local/bin/gluster-manager
RUN chmod +x /usr/local/bin/gluster-manager

# Environment variables
ENV GLUSTER_LOG_LEVEL="info"
ENV GLUSTER_CLUSTER_NAME="gluster-cluster"
ENV GLUSTER_REPLICA_COUNT="3"
ENV GLUSTER_NETWORK_SUBNET="172.20.0.0/16"
ENV GLUSTER_NETWORK_NAME="gluster-net"
ENV GLUSTER_DATA_PATH="/data/glusterfs"

# Create non-root user
RUN adduser -D -s /bin/sh gluster-manager
USER gluster-manager

CMD ["gluster-manager", "start"]