FROM golang:1.21-alpine as builder

# Build the Go application
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o gluster-node ./cmd/gluster-node

# Production image - use minimal Ubuntu
FROM ubuntu:22.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install GlusterFS from Ubuntu repositories
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    glusterfs-server \
    glusterfs-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/*

# Create necessary directories
RUN mkdir -p /data/glusterfs \
    && mkdir -p /var/log/glusterfs \
    && mkdir -p /var/lib/glusterd \
    && mkdir -p /etc/supervisor/conf.d

# Create gluster user
RUN adduser -D -s /bin/false gluster || true

# Set permissions
RUN chown -R gluster:gluster /data/glusterfs \
    && chmod -R 755 /data/glusterfs

# Copy the built binary
COPY --from=builder /build/gluster-node /usr/local/bin/gluster-node
RUN chmod +x /usr/local/bin/gluster-node

# Create supervisor directory and configuration for glusterd
RUN mkdir -p /etc/supervisor/conf.d && \
    echo '[program:glusterd]\n\
command=/usr/sbin/glusterd --no-daemon\n\
autostart=true\n\
autorestart=true\n\
stderr_logfile=/var/log/glusterfs/glusterd.log\n\
stdout_logfile=/var/log/glusterfs/glusterd.log\n\
' > /etc/supervisor/conf.d/glusterd.conf

# Expose GlusterFS ports
EXPOSE 24007 24008 24009 24010 49152 49153 49154 49155 49156 49157 49158 49159

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD gluster peer status || exit 1

# Environment variables
ENV NODE_NAME=""
ENV NODE_IP=""
ENV CLUSTER_NAME="gluster-cluster"
ENV GLUSTER_DATA_PATH="/data/glusterfs"
ENV GLUSTER_LOG_LEVEL="info"

# Create startup script that starts glusterd directly
RUN echo '#!/bin/bash\n\
set -e\n\
echo "Starting GlusterFS node: $NODE_NAME"\n\
\n\
# Create required directories\n\
mkdir -p /var/log/glusterfs\n\
mkdir -p /var/lib/glusterd\n\
mkdir -p /data/glusterfs\n\
\n\
# Start glusterd in background\n\
glusterd --pid-file=/var/run/glusterd.pid --log-file=/var/log/glusterfs/glusterd.log &\n\
\n\
# Wait for glusterd to start\n\
sleep 5\n\
\n\
# Start the gluster-node application\n\
exec /usr/local/bin/gluster-node\n\
' > /start-node.sh && chmod +x /start-node.sh

CMD ["/start-node.sh"]