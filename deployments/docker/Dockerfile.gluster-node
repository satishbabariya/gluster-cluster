# Stage 1: Build the Go application
FROM golang:1.21-alpine AS go-builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o gluster-node ./cmd/gluster-node

# Stage 2: Use official GlusterFS Fedora image for runtime (more current)
# Force AMD64 platform to avoid compatibility issues on ARM64 Macs
FROM --platform=linux/amd64 gluster/gluster-fedora:latest

# Install additional tools needed for our Go application (skip update for speed)
RUN dnf install -y \
    curl \
    ca-certificates \
    which \
    procps-ng \
    && dnf clean all

# Create necessary directories
RUN mkdir -p /data/glusterfs \
    && mkdir -p /var/log/glusterfs \
    && mkdir -p /var/lib/glusterd \
    && mkdir -p /etc/supervisor/conf.d

# The gluster user should already exist in the official image
# Set permissions for data directory
RUN chown -R gluster:gluster /data/glusterfs \
    && chmod -R 755 /data/glusterfs

# Copy the built binary from go-builder stage
COPY --from=go-builder /build/gluster-node /usr/local/bin/gluster-node
RUN chmod +x /usr/local/bin/gluster-node

# GlusterFS should already be configured in the official image
# We just need to ensure our directories exist

# Expose GlusterFS ports
EXPOSE 24007 24008 24009 24010 49152 49153 49154 49155 49156 49157 49158 49159

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD gluster peer status || exit 1

# Environment variables
ENV NODE_NAME=""
ENV NODE_IP=""
ENV CLUSTER_NAME="gluster-cluster"
ENV GLUSTER_DATA_PATH="/data/glusterfs"
ENV GLUSTER_LOG_LEVEL="info"

# Copy and setup the startup script
COPY scripts/start-node.sh /usr/local/bin/start-node.sh
RUN chmod +x /usr/local/bin/start-node.sh

CMD ["/usr/local/bin/start-node.sh"]