FROM ubuntu:20.04 as builder

# Build the Go application
WORKDIR /build
COPY go.mod go.sum ./
RUN apt-get update && apt-get install -y golang-go
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o gluster-node ./cmd/gluster-node

# Production image
FROM ubuntu:20.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install GlusterFS and dependencies
RUN apt-get update && \
    apt-get install -y \
    software-properties-common \
    wget \
    curl \
    systemd \
    systemd-sysv \
    dbus \
    sudo \
    net-tools \
    iputils-ping \
    vim \
    ca-certificates \
    && add-apt-repository ppa:gluster/glusterfs-10 \
    && apt-get update \
    && apt-get install -y \
    glusterfs-server \
    glusterfs-client \
    glusterfs-common \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p /data/glusterfs \
    && mkdir -p /var/log/glusterfs \
    && mkdir -p /var/lib/glusterd

# Create gluster user
RUN useradd -r -s /bin/false gluster || true

# Set permissions
RUN chown -R gluster:gluster /data/glusterfs \
    && chmod -R 755 /data/glusterfs

# Copy the built binary
COPY --from=builder /build/gluster-node /usr/local/bin/gluster-node
RUN chmod +x /usr/local/bin/gluster-node

# Configure systemd
RUN systemctl enable glusterd

# Expose GlusterFS ports
EXPOSE 24007 24008 24009 24010 49152 49153 49154 49155 49156 49157 49158 49159

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD gluster peer status || exit 1

# Environment variables
ENV NODE_NAME=""
ENV NODE_IP=""
ENV CLUSTER_NAME="gluster-cluster"
ENV GLUSTER_DATA_PATH="/data/glusterfs"
ENV GLUSTER_LOG_LEVEL="info"

# Create startup script
RUN echo '#!/bin/bash\n\
set -e\n\
echo "Starting GlusterFS node: $NODE_NAME"\n\
\n\
# Start systemd in background\n\
/usr/sbin/init &\n\
sleep 10\n\
\n\
# Start the gluster-node application\n\
exec /usr/local/bin/gluster-node\n\
' > /start-node.sh && chmod +x /start-node.sh

CMD ["/start-node.sh"]